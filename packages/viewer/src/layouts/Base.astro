---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "Swipe" } = Astro.props;
const pageTitle = title === "Swipe" ? title : `${title} — Swipe`;
---
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{pageTitle}</title>
</head>
<body>
	<header style="padding: var(--space-lg) var(--space-xl); border-bottom: 1px solid var(--color-border);">
		<a href="/" style="font-size: 1.25rem; font-weight: 700; color: var(--color-text);">Swipe</a>
	</header>
	<main style="padding: var(--space-xl); max-width: 1200px; margin: 0 auto;">
		<slot />
	</main>
</body>
</html>
