---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
	const allExamples = await getCollection("examples");
	const problems = [...new Set(allExamples.map((e) => e.data.problem))];

	return problems.map((problem) => {
		const examples = allExamples.filter((e) => e.data.problem === problem);
		return {
			params: { slug: problem },
			props: {
				problemTitle: examples[0].data.problemTitle,
				examples,
			},
		};
	});
}

const { slug } = Astro.params;
const { problemTitle, examples } = Astro.props;
---
<Base title={problemTitle}>
	<nav class="breadcrumb">
		<a href="/">Home</a>
		<span class="separator">/</span>
		<span>{problemTitle}</span>
	</nav>

	<h1 style="margin-bottom: var(--space-xl);">{problemTitle}</h1>

	<div class="card-grid">
		{examples.map((entry: any) => {
			const exampleSlug = entry.id.split("/").pop()?.replace(/\.md$/, "");
			const screenshotPath = `/kb/${entry.data.problem}/${entry.data.screenshot.replace("./", "")}`;
			return (
				<div class="card">
					<a href={`/problems/${slug}/${exampleSlug}`}>
						<img
							src={screenshotPath}
							alt={`Screenshot of ${entry.data.title}`}
							style="border-radius: calc(var(--radius) / 2); margin-bottom: var(--space-md); height: 180px; width: 100%; object-fit: cover;"
							loading="lazy"
						/>
						<h2 style="font-size: 1rem; margin-bottom: var(--space-xs);">{entry.data.title}</h2>
						<p style="color: var(--color-text-muted); font-size: 0.875rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
							{entry.data.design.summary}
						</p>
					</a>
				</div>
			);
		})}
	</div>
</Base>
